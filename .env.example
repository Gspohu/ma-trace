# Every variable the code reads. Copy to .env and adjust, all of them are optional
# and fall back to the defaults baked into core/

# Overpass mirrors, comma separated, tried in order until one answers.
# Only used when the local index does not cover the requested zone
OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter

# Elevation model. Opentopodata caps at 100 locations per call and one call a second
ELEVATION_ENDPOINT=https://api.opentopodata.org/v1/eudem25m

# Where sampled elevations are memoised. Set to 0 or off to disable the memo
ELEVATION_CACHE=data/cache/elevation.sqlite

# The resident engine the web front talks to, when it is running
ENGINE_URL=http://127.0.0.1:8765
